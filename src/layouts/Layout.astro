---
import '@fontsource/libre-bodoni/400.css';
import '@fontsource/libre-bodoni/400-italic.css';
import '@fontsource/libre-bodoni/600.css';
import '@fontsource/libre-bodoni/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	transparentHeader?: boolean;
	showFooter?: boolean;
}

const {
	title,
	description = 'Ana Cantalapiedra — fotografía e ilustración.',
	transparentHeader = false,
	showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title} · Ana Cantalapiedra</title>
	</head>
	<body>
		<Header transparent={transparentHeader} />
		<main>
			<slot />
		</main>
		{showFooter && <Footer />}
	</body>
</html>

<script>
	const io = new IntersectionObserver(
		(entries, observer) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add('reveal--visible');
				observer.unobserve(entry.target);
			});
		},
		{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
	);

	document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
