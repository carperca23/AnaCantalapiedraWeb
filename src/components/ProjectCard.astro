---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	cover: ImageMetadata;
}

const { href, title, cover } = Astro.props;
---

<a class="project-card reveal" href={href}>
	<div class="project-card__thumb">
		<Image src={cover} alt="" width={600} format="webp" />
	</div>
	<p class="project-card__title">{title}</p>
</a>
