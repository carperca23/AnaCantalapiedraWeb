---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
	src: ImageMetadata;
	caption?: string;
}

interface Props {
	images: GalleryImage[];
}

const { images } = Astro.props;

const fullImages = await Promise.all(
	images.map((img) => getImage({ src: img.src, width: 1800, format: 'webp' })),
);
---

<div class="gallery">
	{
		images.map((img, i) => (
			<button
				type="button"
				class="gallery__item reveal"
				data-full={fullImages[i].src}
				data-caption={img.caption ?? ''}
				aria-label={img.caption ? `Ampliar imagen: ${img.caption}` : 'Ampliar imagen'}
			>
				<Image src={img.src} alt={img.caption ?? ''} width={700} format="webp" />
				{img.caption && <span class="gallery__caption">{img.caption}</span>}
			</button>
		))
	}
</div>

<dialog class="lightbox" aria-label="Imagen ampliada">
	<button type="button" class="lightbox__close" aria-label="Cerrar">&times;</button>
	<button type="button" class="lightbox__prev" aria-label="Anterior">&#8249;</button>
	<button type="button" class="lightbox__next" aria-label="Siguiente">&#8250;</button>
	<figure class="lightbox__figure">
		<img src="" alt="" />
		<figcaption class="lightbox__caption"></figcaption>
	</figure>
</dialog>

<script>
	document.querySelectorAll('.gallery').forEach((gallery) => {
		const dialog = gallery.nextElementSibling;
		if (!(dialog instanceof HTMLDialogElement) || !dialog.classList.contains('lightbox')) return;

		const items = Array.from(gallery.querySelectorAll('.gallery__item'));
		const img = dialog.querySelector('img');
		const caption = dialog.querySelector('.lightbox__caption');
		const closeBtn = dialog.querySelector('.lightbox__close');
		const prevBtn = dialog.querySelector('.lightbox__prev');
		const nextBtn = dialog.querySelector('.lightbox__next');
		if (!img || !caption || !closeBtn || !prevBtn || !nextBtn) return;

		let current = 0;

		function show(index) {
			current = (index + items.length) % items.length;
			const item = items[current];
			const full = item.getAttribute('data-full') || '';
			const text = item.getAttribute('data-caption') || '';
			img.src = full;
			img.alt = text;
			caption.textContent = text;
		}

		items.forEach((item, i) => {
			item.addEventListener('click', () => {
				show(i);
				dialog.showModal();
			});
		});

		closeBtn.addEventListener('click', () => dialog.close());
		prevBtn.addEventListener('click', () => show(current - 1));
		nextBtn.addEventListener('click', () => show(current + 1));
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});
	});
</script>
