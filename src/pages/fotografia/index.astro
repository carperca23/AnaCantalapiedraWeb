---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectCover } from '../../lib/projectImages';

const proyectos = (await getCollection('proyectos', ({ data }) => data.category === 'fotografia')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout title="Fotografía">
	<div class="container">
		<h1 style="margin-top: 2.5rem">Fotografía</h1>
		<div class="project-grid">
			{
				proyectos.map((proyecto) => {
					const cover = getProjectCover(proyecto.id);
					return (
						cover && (
							<ProjectCard href={`/proyectos/${proyecto.id}/`} title={proyecto.data.title} cover={cover} />
						)
					);
				})
			}
		</div>
	</div>
</Layout>
